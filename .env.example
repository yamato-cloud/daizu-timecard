# ---- 必須 ----
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# 本番の公開URL（https）。メールのリンクと Google ログインのリダイレクトに使う
APP_BASE_URL=https://timecard.example.com
DATABASE_URL=postgres://daizu:（DBパスワード）@localhost/daizu_timecard
# 32文字以上のランダム文字列（deploy/setup.sh が自動生成する）
SESSION_SECRET=
# 管理者として許可する Google アカウントのメール（カンマ区切り）
ADMIN_EMAILS=yamato@daizu.info,arai@daizu.info

# ---- 管理者ログイン（Google）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google が使えないときの緊急ログイン用（長いランダム文字列。不要なら空のまま）
ADMIN_EMERGENCY_TOKEN=

# ---- メール送信（SMTP）。未設定なら outbox/ にファイル出力 ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=だいずタイムカード <no-reply@daizu.info>

# ---- 任意：Google スプレッドシート出力 ----
GOOGLE_SERVICE_ACCOUNT_FILE=
EXPORT_SPREADSHEET_ID=

# ---- 任意：LINE WORKS（大吉通知。鍵は再発行したものを入れる）----
LW_CLIENT_ID=
LW_CLIENT_SECRET=
LW_SERVICE_ACCOUNT=
LW_PRIVATE_KEY=
LW_BOT_ID=
LW_CHANNEL_ID=

BACKUP_DIR=/var/lib/daizu-timecard/backups
ENABLE_JOBS=true
WEB_DIR=dist/web
